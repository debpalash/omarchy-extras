[
  {
    "slug": "gta6",
    "name": "GTA6",
    "summary": "Four restrained GTA VI palettes, from midnight plum to coastal daylight, with twelve original-resolution backgrounds.",
    "repository": "https://github.com/debpalash/omarchy-gta6-theme",
    "install": "omarchy theme install https://github.com/debpalash/omarchy-gta6-theme.git",
    "wallpaperCount": 12,
    "variants": [
      {
        "slug": "vice-sunset",
        "name": "Vice Sunset",
        "mode": "Dark",
        "description": "The default: charcoal plum with one clean flamingo-pink focus color.",
        "accent": "#ff5c9a",
        "palette": ["#130f17", "#f4eadc", "#62cfc8", "#ff5c9a"],
        "command": "omarchy theme set gta6"
      },
      {
        "slug": "ocean-drive",
        "name": "Ocean Drive",
        "mode": "Dark",
        "description": "Blue-black night surfaces with pool-water cyan for focus and selection.",
        "accent": "#62d5cf",
        "palette": ["#08171d", "#f2ead9", "#ef9567", "#62d5cf"],
        "command": "~/.config/omarchy/themes/gta6/scripts/create-variant.sh ocean-drive"
      },
      {
        "slug": "leonida-night",
        "name": "Leonida Night",
        "mode": "Dark",
        "description": "Midnight plum grounded by warm streetlight gold rather than loud neon.",
        "accent": "#f3b85f",
        "palette": ["#100b16", "#f5e7da", "#69ced0", "#f3b85f"],
        "command": "~/.config/omarchy/themes/gta6/scripts/create-variant.sh leonida-night"
      },
      {
        "slug": "biscayne-day",
        "name": "Biscayne Day",
        "mode": "Light",
        "description": "Low-glare sand surfaces with a deep coastal-teal focus color.",
        "accent": "#146c72",
        "palette": ["#f5efe3", "#241a24", "#ae552c", "#146c72"],
        "command": "~/.config/omarchy/themes/gta6/scripts/create-variant.sh biscayne-day"
      }
    ],
